# Copy this file to .env.local and fill in your project's values.
# Supabase dashboard: Connect (top bar) → App Frameworks, or Project Settings → API Keys.
# Use the PUBLISHABLE key (older projects call it "anon"). Never the secret / service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
